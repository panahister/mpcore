<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MPCore.Templates</PackageId>
    <PackageType>Template</PackageType>
    <VersionPrefix>0.9.1</VersionPrefix>
    <Authors>Mehdi Panahi</Authors>
    <Copyright>Copyright (c) The MP Core contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>dotnet new templates for MP Core DDD backends.</Description>
    <PackageTags>dotnet-new;templates;ddd;grpc;mpcore</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/panahister/mpcore</RepositoryUrl>
    <PackageProjectUrl>https://github.com/panahister/mpcore</PackageProjectUrl>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Remove="content/**/*" />
  </ItemGroup>
</Project>
