<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Authored XML documentation must actually ship inside every package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Mehdi Panahi</Authors>
    <Copyright>Copyright (c) The MP Core contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Reusable backend foundation for DDD-oriented .NET services and modular monoliths.</Description>
    <PackageTags>ddd;grpc;postgresql;wolverine;opentelemetry</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/panahister/mpcore</RepositoryUrl>
    <PackageProjectUrl>https://github.com/panahister/mpcore</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <!--
    The API of every runtime package is validated, on pack, against its package of MPCoreBaselineVersion, the last
    version published to nuget.org (ADR-010, addendum of 2026-10-12). Validation is never skipped in silence, and
    never in CI or the release: a build of a runtime project fails unless eng/restore-api-baseline.sh has downloaded
    that package from nuget.org and proved that nuget.org signed it and that it records the commit of the tag
    v<baseline>, and the one switch for work offline, below, warns for every package and is refused on CI. The proof
    is the stamp <package>.verified beside it, whose first line is the package's SHA-256; it is compared here with
    the file, so a package replaced after the check fails the build as well.

    The package is read from artifacts/packages by its path, never restored through a package source: a NuGet cache
    shared with other builds can hold a package of the same identity built elsewhere. On 2026-10-12 the user-level
    cache of the maintainer's machine held MPCore.Domain 0.10.0 restored from a local copy, without nuget.org's
    signature.

    MPCoreNewInCohort lists, separated by semicolons, the packages that first ship in this cohort and so have no
    baseline. eng/restore-api-baseline.sh proves that nuget.org has none (the stamp <id>.<baseline>.new) and fails
    when it has one; a build fails when a listed package has a baseline in the store. A listing therefore cannot
    switch a package's validation off once its baseline exists.

    One switch builds without a baseline, for work offline: -p:MPCoreOfflineWithoutApiBaseline=true. It warns for
    every package, and fails on a continuous-integration machine (CI or GITHUB_ACTIONS set to true), so neither CI
    nor the release workflow can build with it.
  -->
  <PropertyGroup>
    <MPCoreBaselineVersion>0.10.1</MPCoreBaselineVersion>
    <MPCoreNewInCohort></MPCoreNewInCohort>
    <MPCoreBaselineStore>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'artifacts', 'packages'))</MPCoreBaselineStore>
    <MPCoreBaselinePackagePath>$(MPCoreBaselineStore)$(MSBuildProjectName).$(MPCoreBaselineVersion).nupkg</MPCoreBaselinePackagePath>
    <MPCoreIsNewInCohort>false</MPCoreIsNewInCohort>
    <MPCoreIsNewInCohort Condition="$([System.String]::Copy(';$(MPCoreNewInCohort);').Contains(';$(MSBuildProjectName);'))">true</MPCoreIsNewInCohort>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MPCoreIsNewInCohort)' != 'true' AND '$(MPCoreOfflineWithoutApiBaseline)' != 'true'">
    <PackageValidationBaselinePath>$(MPCoreBaselinePackagePath)</PackageValidationBaselinePath>
  </PropertyGroup>
  <Target Name="MPCoreRequireVerifiedApiBaseline" BeforeTargets="Build;Pack" Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_MPCoreBaselineName>$(MSBuildProjectName) $(MPCoreBaselineVersion)</_MPCoreBaselineName>
      <_MPCoreBaselineStamp>$(MPCoreBaselinePackagePath).verified</_MPCoreBaselineStamp>
      <_MPCoreBaselineAbsence>$(MPCoreBaselineStore)$(MSBuildProjectName).$(MPCoreBaselineVersion).new</_MPCoreBaselineAbsence>
      <_MPCoreBaselineHint>Run ./eng/restore-api-baseline.sh: it downloads the baseline from nuget.org and checks its signature and commit. To build offline without it, set -p:MPCoreOfflineWithoutApiBaseline=true; CI and the release refuse that.</_MPCoreBaselineHint>
      <_MPCoreOnCi>false</_MPCoreOnCi>
      <_MPCoreOnCi Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</_MPCoreOnCi>
      <_MPCoreOffline>false</_MPCoreOffline>
      <_MPCoreOffline Condition="'$(MPCoreOfflineWithoutApiBaseline)' == 'true'">true</_MPCoreOffline>
    </PropertyGroup>

    <Error Condition="$(_MPCoreOffline) AND $(_MPCoreOnCi)"
           Code="MPCORE0001"
           Text="MP Core: MPCoreOfflineWithoutApiBaseline is set on a continuous-integration machine. CI and the release always validate the API of $(MSBuildProjectName) against its baseline $(MPCoreBaselineVersion)." />
    <Warning Condition="$(_MPCoreOffline)"
             Code="MPCORE0002"
             Text="MP Core: API compatibility validation is OFF for $(MSBuildProjectName): MPCoreOfflineWithoutApiBaseline is set. A package built this way was never compared with $(MPCoreBaselineVersion); never release it." />

    <Error Condition="!$(_MPCoreOffline) AND $(MPCoreIsNewInCohort) AND Exists('$(MPCoreBaselinePackagePath)')"
           Code="MPCORE0003"
           Text="MP Core: $(MSBuildProjectName) is listed in MPCoreNewInCohort, but its baseline $(MPCoreBaselineVersion) exists at $(MPCoreBaselinePackagePath). Remove it from the list, so that its API is validated." />
    <Error Condition="!$(_MPCoreOffline) AND $(MPCoreIsNewInCohort) AND !Exists('$(_MPCoreBaselineAbsence)')"
           Code="MPCORE0004"
           Text="MP Core: $(MSBuildProjectName) is listed in MPCoreNewInCohort, and nothing proves that nuget.org has no $(_MPCoreBaselineName). $(_MPCoreBaselineHint)" />

    <Error Condition="!$(_MPCoreOffline) AND !$(MPCoreIsNewInCohort) AND !Exists('$(MPCoreBaselinePackagePath)')"
           Code="MPCORE0005"
           Text="MP Core: the API baseline $(_MPCoreBaselineName) is missing at $(MPCoreBaselinePackagePath), so its API cannot be validated. $(_MPCoreBaselineHint)" />
    <Error Condition="!$(_MPCoreOffline) AND !$(MPCoreIsNewInCohort) AND !Exists('$(_MPCoreBaselineStamp)')"
           Code="MPCORE0006"
           Text="MP Core: the API baseline $(_MPCoreBaselineName) at $(MPCoreBaselinePackagePath) was never verified. $(_MPCoreBaselineHint)" />
    <GetFileHash Condition="!$(_MPCoreOffline) AND !$(MPCoreIsNewInCohort)" Files="$(MPCoreBaselinePackagePath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_MPCoreBaselineHash" />
    </GetFileHash>
    <Error Condition="!$(_MPCoreOffline) AND !$(MPCoreIsNewInCohort) AND !$([System.IO.File]::ReadAllText('$(_MPCoreBaselineStamp)').StartsWith('$(_MPCoreBaselineHash.ToLowerInvariant())'))"
           Code="MPCORE0007"
           Text="MP Core: the API baseline $(_MPCoreBaselineName) at $(MPCoreBaselinePackagePath) is not the package that was verified (SHA-256 $(_MPCoreBaselineHash.ToLowerInvariant())). $(_MPCoreBaselineHint)" />
  </Target>
  <!--
    The public API of every runtime package is recorded in the project's PublicAPI.Shipped.txt (what a published
    version promised) and PublicAPI.Unshipped.txt (what changed since), and the build fails on an undeclared
    change: RS0016 for a public symbol the files do not list, RS0017 for a listed symbol that is gone. A removal is
    recorded as *REMOVED* in PublicAPI.Unshipped.txt, and the break against the baseline in
    CompatibilitySuppressions.xml, with its reason (docs/api/README.md).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../docs/nuget/README.md"
          Pack="true"
          PackagePath="README.md" />
  </ItemGroup>
</Project>
