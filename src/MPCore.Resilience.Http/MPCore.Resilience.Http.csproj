<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MPCore.Resilience.Http</PackageId>
    <Description>Outbound HTTP clients for MP Core hosts: the standard resilience pipeline (retry, circuit breaker, timeouts, rate limiter), and the service's own identity on a call to another service (OAuth 2.0 client credentials).</Description>
