{
  "template": "mpcore-backend",
  "parameters": {
    "aiTooling": {
      "datatype": "choice",
      "required": false,
      "default": "both",
      "choices": [
        "both",
        "claude",
        "codex",
        "none"
      ]
    },
    "businessAudit": {
      "datatype": "choice",
      "required": false,
      "default": "none",
      "choices": [
        "none",
        "postgresql"
      ]
    },
    "cache": {
      "datatype": "choice",
      "required": false,
      "default": "memory",
      "choices": [
        "hybrid",
        "memory",
        "none",
        "redis"
      ]
    },
    "component": {
      "datatype": "text",
      "required": false,
      "default": "Backend"
    },
    "messaging": {
      "datatype": "choice",
      "required": false,
      "default": "kafka",
      "choices": [
        "kafka",
        "none",
        "rabbitmq"
      ]
    },
    "mpcoreVersion": {
      "datatype": "text",
      "required": false,
      "default": "\u003Ccohort version\u003E"
    },
    "organization": {
      "datatype": "text",
      "required": false,
      "default": "MPCore"
    },
    "securityAudience": {
      "datatype": "text",
      "required": false,
      "default": "replace-me"
    },
    "securityAuthority": {
      "datatype": "text",
      "required": false,
      "default": "https://identity.invalid/realms/replace-me"
    },
    "shape": {
      "datatype": "choice",
      "required": false,
      "default": "service",
      "choices": [
        "modular-monolith",
        "service"
      ]
    },
    "templateVersion": {
      "datatype": "text",
      "required": false,
      "default": "\u003Ccohort version\u003E"
    },
    "timeseries": {
      "datatype": "choice",
      "required": false,
      "default": "none",
      "choices": [
        "none",
        "timescale"
      ]
    },
    "transport": {
      "datatype": "choice",
      "required": true,
      "choices": [
        "both",
        "grpc",
        "rest"
      ]
    }
  },
