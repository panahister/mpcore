<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources of this repository: nuget.org, and nothing else. No credentials are stored here, and none
  belong here.

  The API baseline is not a package source. src/Directory.Build.props reads the baseline package from
  artifacts/packages by its path, after eng/restore-api-baseline.sh downloaded it from nuget.org and checked it
  (ADR-010, addendum of 2026-10-12). That folder is git-ignored build output and never a publication source:
  releases pack into artifacts/release/<version>, and pushing from artifacts/packages would upload superseded
  cohorts. Listing it here would let build output answer a restore for an MPCore.* identifier.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
