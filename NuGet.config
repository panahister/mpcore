<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-local package sources. No credentials are stored here, and none belong here.

  artifacts/packages supplies the baseline cohort that PackageValidationBaselineVersion compares the
  current API surface against, when a maintainer has seeded one. In a fresh clone the folder is empty. It is a baseline
  folder only and is never a publication source: releases pack into artifacts/release/<version>,
  and pushing from this folder would upload superseded cohorts. Both are git-ignored build output,
  so packageSourceMapping restricts this source to MPCore.* only - a build output directory must
  never be able to outrank nuget.org for a third-party identifier.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="mpcore-baseline" value="artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="mpcore-baseline">
      <package pattern="MPCore.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
